<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ AI Art Generator"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/welcome_subtitle"
                android:textColor="@color/white_70"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp" />

        </LinearLayout>

        <!-- Mode Tabs (Image / Video) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tabs_container"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabImage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_active"
                android:gravity="center"
                android:text="🖼 Изображение"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabVideo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🎬 Видео"
                android:textColor="@color/white_50"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Model Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 Модель:"
                android:textColor="@color/white_70"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/modelChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Video Duration (only visible in video mode) -->
        <LinearLayout
            android:id="@+id/durationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Длительность:"
                android:textColor="@color/white_70"
                android:textSize="13sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/btnDurationMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 сек"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/btnDurationPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Image/Video Display Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/dark_card">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Placeholder when no image -->
                <LinearLayout
                    android:id="@+id/placeholderLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvPlaceholderEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨"
                        android:textSize="56sp" />

                    <TextView
                        android:id="@+id/tvPlaceholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ваше изображение появится здесь"
                        android:textColor="@color/white_50"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Generated Image -->
                <ImageView
                    android:id="@+id/imgResult"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Loading overlay -->
                <FrameLayout
                    android:id="@+id/loadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC1A1A2E"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ProgressBar
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:indeterminateTint="@color/purple_primary" />

                        <TextView
                            android:id="@+id/tvLoadingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/generating"
                            android:textColor="@color/white_70"
                            android:textSize="14sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="⏱ 0 сек"
                            android:textColor="@color/white_50"
                            android:textSize="13sp" />

                    </LinearLayout>

                </FrameLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action buttons for result -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_action_button"
                android:gravity="center"
                android:text="💾 Сохранить"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_action_button"
                android:gravity="center"
                android:text="📤 Поделиться"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Input Section -->
        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_prompt"
            android:textColorHint="@color/white_50"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:padding="16dp"
            android:minHeight="72dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="4" />

        <!-- Quick Prompts -->
        <TextView
            android:id="@+id/tvIdeasLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="💡 Идеи для вдохновения:"
            android:textColor="@color/white_70"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/chipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip1"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="🌌 Космос"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip2"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="🐉 Дракон"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip3"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="🏙️ Киберпанк"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip4"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="🌸 Японский сад"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="🎭 Сюрреализм"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Generate Button -->
        <TextView
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_generate"
            android:gravity="center"
            android:text="@string/btn_generate"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
